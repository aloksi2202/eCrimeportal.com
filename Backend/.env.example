# These are examples only. Spring Boot does not automatically load .env files.
# Set these as operating-system environment variables before starting the backend.
DB_URL=jdbc:mysql://localhost:3306/ecrimeportaldb
DB_USERNAME=root
DB_PASSWORD=replace_with_your_local_mysql_password
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_oauth_client_secret
JWT_SECRET=replace_with_at_least_32_random_bytes
NEWS_API_KEY=replace_with_your_newsapi_key
